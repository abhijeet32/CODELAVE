# ------------------------------------------
# Database Connections (Cloud Hosted)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-cloud-database.com:5432/codelave?schema=public"
REDIS_URL="redis://default:YOUR_PASSWORD@your-cloud-redis.com:6379"

# ------------------------------------------
# Dashboard Frontend Configuration
# ------------------------------------------
# The URL where the Next.js dashboard can reach the NestJS API server locally
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ------------------------------------------
# Security & JWT Auth
# ------------------------------------------
JWT_SECRET="super_secret_codelave_jwt_key_for_development"
JWT_EXPIRATION="7d"

# ------------------------------------------
# Sandbox Execution Engine
# ------------------------------------------
# Time in seconds before a runaway sandbox is forcefully killed
SANDBOX_EXECUTION_TIMEOUT=30
# Maximum memory allowed per sandbox container
SANDBOX_MEMORY_LIMIT="256m"
# Maximum CPU cores allowed per sandbox
SANDBOX_CPU_LIMIT="0.5"
