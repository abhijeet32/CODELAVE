generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SandboxStatus {
  CREATING
  RUNNING
  STOPPED
  DESTROYED
  ERROR
  TIMED_OUT
  LOST
}

// ─── USERS ──────────────────────────────────────────────────

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  plan      UserPlan   @default(FREE)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  apiKeys   ApiKey[]
  sandboxes Sandbox[]
  usage     Usage[]

  @@map("users")
}

// ─── API KEYS ───────────────────────────────────────────────

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsed  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
  @@map("api_keys")
}

// ─── TEMPLATES ──────────────────────────────────────────────

model Template {
  id          String  @id @default(uuid())
  name        String  @unique
  dockerImage String
  hasInternet Boolean @default(false)
  description String?

  sandboxes Sandbox[]

  @@map("templates")
}

// ─── SANDBOXES ──────────────────────────────────────────────

model Sandbox {
  id          String        @id @default(uuid())
  userId      String
  status      SandboxStatus @default(CREATING)
  templateId  String?
  containerId String?       @unique
  createdAt   DateTime      @default(now())
  timeoutAt   DateTime
  destroyedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template?   @relation(fields: [templateId], references: [id])
  executions Execution[]
  files      File[]

  @@index([userId])
  @@index([status])
  @@index([timeoutAt])
  @@map("sandboxes")
}

// ─── EXECUTIONS ─────────────────────────────────────────────

model Execution {
  id         String   @id @default(uuid())
  sandboxId  String
  code       String
  output     String?
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@map("executions")
}

// ─── FILES ──────────────────────────────────────────────────

model File {
  id         String   @id @default(uuid())
  sandboxId  String
  name       String
  size       Int
  s3Path     String?
  uploadedAt DateTime @default(now())

  sandbox Sandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@index([sandboxId])
  @@map("files")
}

// ─── USAGE ──────────────────────────────────────────────────

model Usage {
  id             String @id @default(uuid())
  userId         String
  month          String // format: "2026-05"
  sandboxCount   Int    @default(0)
  executionCount Int    @default(0)
  computeSeconds Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@map("usage")
}
